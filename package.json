{
  "name": "vite-react-typescript-starter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "allowScripts": {
    "esbuild@0.21.5": true
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "test:audit-cleanup": "node --test supabase/tests/audit-cleanup.test.mjs",
    "test:employee-regions": "node --test supabase/tests/employee-regions.test.mjs",
    "test:employee-login-maintenance": "node --test supabase/tests/employee-login-maintenance.test.mjs",
    "test:service-chat": "node --test supabase/tests/service-chat-scale.test.mjs",
    "test:work-session": "node --test supabase/tests/work-session-stop.test.mjs",
    "test:dispatch-timing": "node --test supabase/tests/dispatch-timing.test.mjs supabase/tests/employee-login-maintenance.test.mjs",
    "test:rich-content": "node --test supabase/tests/rich-content-length.test.mjs",
    "test:module-recovery": "node --test supabase/tests/module-load-recovery.test.mjs",
    "test:migration-check": "node --test supabase/tests/migration-check.test.mjs supabase/tests/storage-copy-tool.test.mjs supabase/tests/storage-origin-switch.test.mjs",
    "test:wallet-deadlock": "node --test --test-concurrency=1 supabase/tests/wallet-reconciliation-deadlock.test.mjs",
    "test:admin-session": "node --test supabase/tests/admin-session-expiry.test.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.4",
    "@tiptap/core": "^3.10.2",
    "@tiptap/extension-color": "^3.10.2",
    "@tiptap/extension-image": "^3.10.2",
    "@tiptap/extension-placeholder": "^3.10.2",
    "@tiptap/extension-text-align": "^3.10.2",
    "@tiptap/extension-text-style": "^3.10.2",
    "@tiptap/pm": "^3.10.2",
    "@tiptap/react": "^3.10.2",
    "@tiptap/starter-kit": "^3.10.2",
    "bcryptjs": "^3.0.2",
    "dompurify": "^3.3.0",
    "lucide-react": "^0.344.0",
    "mammoth": "^1.11.0",
    "marked": "^16.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@eslint/js": "^9.9.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/dompurify": "^3.0.5",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.18",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^5.4.2"
  }
}
